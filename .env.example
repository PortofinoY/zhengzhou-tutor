# 此文件只列出变量名，项目不会自动加载它。请在部署平台或进程管理器中配置真实值。

# 本地开发
NODE_ENV=development
ALLOW_MOCK_FEATURES=true
SEED_DEMO_DATA=true
PORT=3000
HOST=127.0.0.1
TUTOR_DB_PATH=
DATA_DRIVER=json

# MySQL 模式必填。生产环境必须配置 DATA_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL_ENABLED=false

# 生产环境必填
TUTOR_TOKEN_SECRET=
WECHAT_APPID=
WECHAT_SECRET=

# 仅执行 npm run init-admin 时使用
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PHONE=

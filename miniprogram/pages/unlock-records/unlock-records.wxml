<view class="page records-page">
  <view class="records-hero">
    <view class="records-title">我的解锁记录</view>
    <view class="records-subtitle">已付费解锁的信息会保留在这里，后续可重复查看。</view>
  </view>

  <view wx:if="{{records.length === 0}}" class="empty-card">
    <view class="empty-icon">锁</view>
    <view class="empty-title">暂无解锁记录</view>
    <view class="empty-desc">解锁老师或家长联系方式后，记录会显示在这里。</view>
  </view>

  <view wx:for="{{records}}" wx:key="id" class="record-card tap-active" data-id="{{item.id}}" bindtap="openDetail">
    <view class="record-head">
      <view>
        <view class="record-title">{{item.targetName || item.typeText}}</view>
        <view class="record-meta">{{item.targetSummary || item.typeText}}</view>
      </view>
      <view class="record-amount">{{item.amountText}}</view>
    </view>
    <view class="record-foot">
      <text class="tag-neutral">{{item.typeText}}</text>
      <text class="record-time">{{item.timeText}}</text>
    </view>
  </view>
</view>

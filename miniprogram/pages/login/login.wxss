page {
  background: #F7F8FA;
}

.login-page {
  min-height: 100vh;
  padding: 28rpx;
  background: #F7F8FA;
}

.brand-card {
  margin-top: 4rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #1E3A5F;
  box-shadow: 0 10rpx 26rpx rgba(30, 58, 95, 0.12);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #1E3A5F;
  background: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
}

.brand-title {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
}

.brand-desc {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.55;
}

.login-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #E5EAF0;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 22rpx rgba(30, 58, 95, 0.06);
}

.login-title {
  color: #1F2933;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.login-desc {
  margin-top: 14rpx;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.55;
}

.account-form {
  margin-top: 26rpx;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: #1F2933;
  font-size: 26rpx;
  font-weight: 800;
}

.login-input {
  height: 82rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  border: 1rpx solid #E5EAF0;
  border-radius: 22rpx;
  color: #1F2933;
  background: #F7F8FA;
  font-size: 27rpx;
  font-weight: 600;
}

.input-placeholder {
  color: #9CA3AF;
  font-weight: 500;
}

.agreement {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 30rpx;
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.link {
  color: #2BB3A3;
  font-weight: 800;
}

.account-login,
.wechat-login {
  width: 100%;
  height: 80rpx;
  margin: 24rpx auto 0;
  border-radius: 999rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(43, 179, 163, 0.22);
  font-size: 27rpx;
  font-weight: 800;
}

.account-login {
  background: #2BB3A3;
}

.register-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 20rpx;
  font-size: 25rpx;
}

.register-text {
  color: #6B7280;
}

.register-link {
  color: #2BB3A3;
  font-weight: 800;
}

.login-divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 26rpx 0 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #E5EAF0;
}

.divider-text {
  color: #9CA3AF;
  font-size: 24rpx;
  font-weight: 700;
}

.wechat-login {
  background: #1E3A5F;
  box-shadow: 0 8rpx 20rpx rgba(30, 58, 95, 0.16);
}

.wechat-icon {
  width: 48rpx;
  height: 48rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  border-radius: 14rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 900;
}

<view class="page">
  <view class="section">
    <view class="title"><text class="title-icon">评</text>评价老师</view>
    <view class="subtitle">评价提交后不可修改，每个订单只能评价一次。</view>
  </view>

  <view class="section">
    <view class="score-item">
      <view class="between"><text class="label">星级评分</text><text class="price">{{form.starRating}} 分</text></view>
      <slider min="1" max="5" step="1" value="{{form.starRating}}" data-field="starRating" bindchange="onScore" activeColor="#2BB3A3" />
    </view>
    <view class="score-item">
      <view class="between"><text class="label">教学态度</text><text class="price">{{form.attitudeRating}} 分</text></view>
      <slider min="1" max="5" step="1" value="{{form.attitudeRating}}" data-field="attitudeRating" bindchange="onScore" activeColor="#2BB3A3" />
    </view>
    <view class="score-item">
      <view class="between"><text class="label">准时情况</text><text class="price">{{form.punctualityRating}} 分</text></view>
      <slider min="1" max="5" step="1" value="{{form.punctualityRating}}" data-field="punctualityRating" bindchange="onScore" activeColor="#2BB3A3" />
    </view>
    <view class="score-item">
      <view class="between"><text class="label">讲解清晰度</text><text class="price">{{form.clarityRating}} 分</text></view>
      <slider min="1" max="5" step="1" value="{{form.clarityRating}}" data-field="clarityRating" bindchange="onScore" activeColor="#2BB3A3" />
    </view>
    <view class="score-item">
      <view class="between"><text class="label">孩子接受度</text><text class="price">{{form.childAcceptanceRating}} 分</text></view>
      <slider min="1" max="5" step="1" value="{{form.childAcceptanceRating}}" data-field="childAcceptanceRating" bindchange="onScore" activeColor="#2BB3A3" />
    </view>
    <view class="form-item">
      <text class="label">文字评价</text>
      <textarea class="textarea" maxlength="300" value="{{form.content}}" data-field="content" bindinput="onInput"></textarea>
    </view>
    <button class="btn btn-primary" bindtap="submit"><text class="btn-icon">✓</text><text>提交评价</text></button>
  </view>
</view>

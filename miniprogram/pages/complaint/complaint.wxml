<view class="page">
  <view class="section">
    <view class="title"><text class="title-icon">问</text>遇到问题</view>
    <view class="subtitle">平台会保留问题记录，管理员处理后可查看处理状态。</view>
  </view>

  <view class="section">
    <view class="form-item">
      <text class="label">问题类型</text>
      <picker range="{{reasons}}" bindchange="onReason">
        <view class="picker-value">{{form.reason || '请选择问题类型'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">问题说明</text>
      <textarea class="textarea" maxlength="500" value="{{form.description}}" data-field="description" bindinput="onInput"></textarea>
    </view>
    <button class="btn btn-ghost" disabled="{{imagesUploading}}" bindtap="chooseImages"><text class="btn-icon">图</text><text>{{imagesUploading ? '图片上传中...' : '上传图片证据（最多 6 张）'}}</text></button>
    <view class="muted image-count">已上传 {{form.images.length}} 张</view>
    <button class="btn btn-primary submit" disabled="{{imagesUploading}}" bindtap="submit"><text class="btn-icon">✓</text><text>提交问题</text></button>
  </view>
</view>

<view class="page safe-bottom" wx:if="{{teacher}}">
  <view class="band profile-band">
    <image class="avatar-large" src="{{teacher.avatar}}" mode="aspectFill" />
    <view class="title"><text class="title-icon">师</text>{{teacher.displayName}} · {{teacher.gender}}</view>
    <view class="subtitle">{{teacher.school}} / {{teacher.major}} / {{teacher.grade}}</view>
    <view class="tag-row">
      <text class="tag-cert" wx:for="{{teacher.certificationTags}}" wx:key="*this">{{item}}</text>
      <text class="tag">{{teacher.orderStatusText}}</text>
      <text class="tag">评分 {{teacher.rating}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row between">
      <view>
        <view class="label">课时费</view>
        <view class="price">{{teacher.hourlyRate}} 元/小时</view>
      </view>
      <view>
        <view class="label">完成订单</view>
        <view class="price">{{teacher.completedOrderCount}} 单</view>
      </view>
    </view>
  </view>

  <view class="section-title">可授课信息</view>
  <view class="card">
    <view class="label">科目</view>
    <text class="tag" wx:for="{{teacher.subjects}}" wx:key="*this">{{item}}</text>
    <view class="label spacing">年级</view>
    <text class="tag" wx:for="{{teacher.teachGrades}}" wx:key="*this">{{item}}</text>
    <view class="label spacing">区域</view>
    <text class="tag" wx:for="{{teacher.serviceAreas}}" wx:key="*this">{{item}}</text>
    <view class="label spacing">时间</view>
    <text class="tag" wx:for="{{teacher.availableTimes}}" wx:key="*this">{{item}}</text>
    <view wx:if="{{teacher.suitableTags && teacher.suitableTags.length}}" class="label spacing">适合人群</view>
    <block wx:if="{{teacher.suitableTags && teacher.suitableTags.length}}">
      <text class="tag-neutral suitable-tag" wx:for="{{teacher.suitableTags}}" wx:key="*this">{{item}}</text>
    </block>
  </view>

  <view class="section-title">平台审核说明</view>
  <view class="card trust-card">
    <view class="trust-line"><text class="trust-icon">核</text><text>平台已核验老师基础资料和学生证材料。</text></view>
    <view class="trust-line"><text class="trust-icon">约</text><text>平台会记录预约、上课状态和评价反馈。</text></view>
    <view class="trust-line"><text class="trust-icon">提</text><text>请家长结合孩子情况、老师介绍和评价内容谨慎选择。</text></view>
  </view>

  <view class="section-title">个人介绍</view>
  <view class="card text-block">{{teacher.introduction}}</view>

  <view class="section-title">教学经历</view>
  <view class="card text-block">{{teacher.teachingExperience || '暂无补充'}}</view>

  <view class="section-title">家长评价</view>
  <view wx:if="{{reviews.length === 0}}" class="empty">暂无评价</view>
  <view wx:for="{{reviews}}" wx:key="id" class="card">
    <view class="row between">
      <view class="teacher-name">{{item.parentNickname}}</view>
      <view class="price">{{item.starRating}} 分</view>
    </view>
    <view class="review-dims">讲解 {{item.clarityRating}} · 准时 {{item.punctualityRating}} · 态度 {{item.attitudeRating}} · 接受度 {{item.childAcceptanceRating}}</view>
    <view class="muted">{{item.content || '家长未填写文字评价'}}</view>
  </view>

  <view class="fixed-bottom">
    <button class="button-primary" disabled="{{teacher.orderStatus !== 'available'}}" bindtap="reserve"><text class="btn-icon">约</text><text>预约老师</text></button>
  </view>
</view>

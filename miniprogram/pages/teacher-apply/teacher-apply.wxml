<view class="page">
  <view class="section">
    <view class="title"><text class="title-icon">师</text>老师入驻</view>
    <view class="subtitle">提交基础资料和学生证照片后进入平台审核，教学经历和高考成绩说明为选填，不影响提交申请。</view>
    <view class="completeness-card">
      <view class="between">
        <text class="completeness-label">资料完整度</text>
        <text class="completeness-value">{{profileCompleteness}}%</text>
      </view>
      <view class="progress-track"><view class="progress-bar" style="width: {{profileCompleteness}}%;"></view></view>
    </view>
  </view>

  <view class="section">
    <view class="grid">
      <view class="form-item">
        <text class="label">真实姓名</text>
        <input class="input" maxlength="20" value="{{form.realName}}" data-field="realName" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="label">性别</text>
        <picker range="{{genders}}" data-field="gender" bindchange="onPicker">
          <view class="picker-value">{{form.gender || '请选择'}}</view>
        </picker>
      </view>
    </view>
    <view class="form-item">
      <text class="label">已授权手机号</text>
      <view class="readonly-value">{{phoneMasked || '提交前请先授权手机号'}}</view>
    </view>
    <view class="grid">
      <view class="form-item">
        <text class="label">所在学校</text>
        <picker range="{{schools}}" data-field="school" bindchange="onPicker">
          <view class="picker-value">{{form.school || '请选择'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="label">当前年级</text>
        <input class="input" value="{{form.grade}}" data-field="grade" bindinput="onInput" placeholder="如 大二" />
      </view>
    </view>
    <view class="form-item">
      <text class="label">所在专业</text>
      <input class="input" value="{{form.major}}" data-field="major" bindinput="onInput" />
    </view>
    <view class="grid">
      <button class="btn btn-ghost" bindtap="chooseAvatar"><text class="btn-icon">像</text><text>{{form.avatar ? '已选择头像' : '上传本人头像'}}</text></button>
      <button class="btn btn-ghost" bindtap="chooseCertification"><text class="btn-icon">证</text><text>{{form.certificationImage ? '已选择学生证照片' : '上传学生证照片'}}</text></button>
    </view>
  </view>

  <view class="section">
    <view class="form-item">
      <text class="label">个人介绍</text>
      <textarea class="textarea" maxlength="500" value="{{form.introduction}}" data-field="introduction" bindinput="onInput"></textarea>
    </view>
    <view class="form-item">
      <text class="label">教学经历</text>
      <textarea class="textarea" maxlength="500" value="{{form.teachingExperience}}" data-field="teachingExperience" bindinput="onInput"></textarea>
    </view>
    <view class="label">适合人群（最多3个）</view>
    <view class="choice-row">
      <text wx:for="{{suitableTagOptions}}" wx:key="label" class="choice {{item.selected ? 'active' : ''}}" data-field="suitableTags" data-value="{{item.label}}" bindtap="toggleArray">{{item.label}}</text>
    </view>
    <view class="form-item">
      <text class="label">课时费（元/小时）</text>
      <input class="input" type="number" value="{{form.hourlyRate}}" data-field="hourlyRate" bindinput="onInput" />
    </view>
  </view>

  <view class="section">
    <view class="label">选填补充说明</view>
    <view class="help-text">可补充擅长学科或学习方法特点，不作为提交入驻的必填条件。</view>
    <view class="form-item">
      <text class="label small-label">高考成绩说明</text>
      <textarea class="textarea compact-textarea" maxlength="300" value="{{form.gaokaoScore}}" data-field="gaokaoScore" bindinput="onInput" placeholder="可填写擅长学科或学习方法特点"></textarea>
    </view>
  </view>

  <view class="section">
    <view class="label">可授课科目</view>
    <view class="choice-row">
      <text wx:for="{{subjectOptions}}" wx:key="label" class="choice {{item.selected ? 'active' : ''}}" data-field="subjects" data-value="{{item.label}}" bindtap="toggleArray">{{item.label}}</text>
    </view>
    <view class="label spacing">可授课年级</view>
    <view class="choice-row">
      <text wx:for="{{teachGradeOptions}}" wx:key="label" class="choice {{item.selected ? 'active' : ''}}" data-field="teachGrades" data-value="{{item.label}}" bindtap="toggleArray">{{item.label}}</text>
    </view>
    <view class="label spacing">可授课区域</view>
    <view class="choice-row">
      <text wx:for="{{areaOptions}}" wx:key="label" class="choice {{item.selected ? 'active' : ''}}" data-field="serviceAreas" data-value="{{item.label}}" bindtap="toggleArray">{{item.label}}</text>
    </view>
    <view class="label spacing">可授课时间</view>
    <view class="choice-row">
      <text wx:for="{{timeOptions}}" wx:key="label" class="choice {{item.selected ? 'active' : ''}}" data-field="availableTimes" data-value="{{item.label}}" bindtap="toggleArray">{{item.label}}</text>
    </view>
  </view>

  <button class="btn btn-primary submit" bindtap="submit"><text class="btn-icon">✓</text><text>提交入驻申请</text></button>
</view>

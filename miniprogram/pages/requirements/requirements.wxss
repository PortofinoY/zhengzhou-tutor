.requirements-page {
  padding-bottom: 42rpx;
}

.requirement-filter,
.requirement-card {
  border: 1rpx solid #E5EAF0;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(30, 58, 95, 0.05);
}

.requirement-filter {
  padding: 26rpx;
  margin-bottom: 22rpx;
}

.filter-title {
  color: #1F2933;
  font-size: 36rpx;
  font-weight: 900;
}

.filter-subtitle {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.search-panel {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 12rpx;
  border: 1rpx solid #E5EAF0;
  border-radius: 999rpx;
}

.search-icon {
  color: #2BB3A3;
  font-size: 30rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  color: #1F2933;
  font-size: 25rpx;
}

.search-button {
  width: 112rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #2BB3A3;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 900;
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.picker.compact {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E5EAF0;
  border-radius: 16rpx;
  color: #1E3A5F;
  font-size: 24rpx;
  font-weight: 800;
}

.requirement-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  transition: transform 160ms ease, opacity 160ms ease;
}

.requirement-card:active {
  transform: scale(0.985);
  opacity: 0.94;
}

.requirement-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.requirement-title {
  color: #1F2933;
  font-size: 30rpx;
  font-weight: 900;
}

.requirement-meta,
.requirement-desc {
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.requirement-meta {
  margin-top: 8rpx;
}

.requirement-price {
  flex: none;
  color: #B86635;
  font-size: 25rpx;
  font-weight: 900;
}

.requirement-desc {
  margin-top: 18rpx;
}

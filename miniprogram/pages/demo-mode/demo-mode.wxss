page { background: #F6F8F8; }

.demo-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #EAF8F5 0%, #F6F8F8 38%, #F6F8F8 100%);
}

.demo-card,
.role-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(30, 58, 95, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(30, 58, 95, 0.055);
}

.intro-card { padding: 30rpx; }
.eyebrow { color: #2BB3A3; font-size: 22rpx; font-weight: 800; letter-spacing: 2rpx; }
.page-title { margin-top: 10rpx; color: #1F2933; font-size: 38rpx; font-weight: 800; line-height: 1.25; }
.page-desc { margin-top: 10rpx; color: #6B7280; font-size: 25rpx; line-height: 1.55; }
.active-status { display: inline-flex; margin-top: 18rpx; padding: 10rpx 16rpx; border-radius: 999rpx; color: #168F80; background: #EAF8F4; font-size: 22rpx; font-weight: 700; }

.role-card { margin-top: 20rpx; padding: 28rpx; }
.parent-card { background: linear-gradient(135deg, #FFFFFF, #F2FBF9); }
.teacher-card { background: linear-gradient(135deg, #FFFFFF, #F1F6FD); }
.role-title { color: #1F2933; font-size: 32rpx; font-weight: 800; }
.role-desc { min-height: 68rpx; margin-top: 10rpx; color: #6B7280; font-size: 24rpx; line-height: 1.45; }
.role-button,
.demo-action { width: 100%; height: 72rpx; margin-top: 22rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; line-height: 72rpx; }
.parent-button { color: #FFFFFF; background: #2BB3A3; }
.teacher-button { color: #FFFFFF; background: #1E3A5F; }
.demo-actions { margin-top: 20rpx; }
.demo-action { margin-top: 14rpx; }
.secondary { color: #1E3A5F; border: 1rpx solid #DDE8E7; background: #FFFFFF; }
.danger { color: #D94A4A; border: 1rpx solid #F3D7D7; background: #FFF8F8; }
.unavailable-card { padding: 32rpx; }
.tap-feedback:active { opacity: 0.92; transform: scale(0.985); }

<view class="page profile-page">
  <view class="profile-hero tap-feedback" bindtap="goUserProfile">
    <view class="profile-user-row">
      <view wx:if="{{user && user.avatar}}" class="avatar-wrap">
        <image class="avatar-img" src="{{user.avatar}}" mode="aspectFill"></image>
      </view>
      <view wx:else class="avatar-wrap avatar-placeholder">{{user ? '家' : '未'}}</view>
      <view class="user-copy">
        <view class="user-name">{{user ? (user.nickname || '微信用户') : '请登录'}}</view>
        <view wx:if="{{user}}" class="user-tags">
          <text class="pill pill-cert">{{currentRoleText}}</text>
          <text class="pill {{user.phoneBound ? 'pill-success' : 'pill-warning'}}">{{phoneStatusText}}</text>
          <text wx:if="{{demoModeActive}}" class="pill pill-demo">演示模式</text>
        </view>
        <view wx:else class="user-desc">登录后管理预约、资料与服务记录</view>
      </view>
      <text wx:if="{{user}}" class="profile-arrow">›</text>
    </view>
    <view wx:if="{{user}}" class="hero-actions">
      <button class="identity-btn" catchtap="goIdentity">切换身份</button>
      <button wx:if="{{!user.phoneBound}}" class="identity-btn primary" catchtap="goBindPhone">绑定手机号</button>
    </view>
    <button wx:else class="login-main-btn" catchtap="goWechatLogin">微信登录</button>
  </view>

  <view wx:if="{{loading}}" class="state-strip">正在更新个人服务信息</view>
  <view wx:if="{{loadFailed && user}}" class="state-strip state-error" bindtap="loadProfile">信息加载失败，点击重试</view>

  <view wx:if="{{user}}" class="profile-card action-card">
    <view class="section-head">
      <view>
        <view class="module-title">{{user.currentRole === 'teacher' ? '老师服务' : '家长服务'}}</view>
        <view class="module-desc">{{user.currentRole === 'teacher' ? teacherStatusDesc : '找到合适老师，管理预约与需求'}}</view>
      </view>
      <text wx:if="{{user.currentRole === 'teacher'}}" class="status-pill {{teacherStatusClass}}">{{teacherStatusText}}</text>
    </view>

    <view wx:if="{{user.currentRole === 'teacher'}}" class="core-action core-action-teacher tap-feedback" bindtap="goRequirements">
      <view>
        <view class="core-action-title">找需求</view>
        <view class="core-action-desc">查看适合自己的辅导需求</view>
      </view>
      <text class="core-action-arrow">›</text>
    </view>
    <view wx:else class="core-action tap-feedback" bindtap="goTeachers">
      <view>
        <view class="core-action-title">找老师</view>
        <view class="core-action-desc">按科目、年级和区域筛选</view>
      </view>
      <text class="core-action-arrow">›</text>
    </view>

    <view class="core-menu-grid">
      <view class="core-menu-item tap-feedback" bindtap="goOrders">
        <text class="core-menu-title">我的订单</text>
        <text class="core-menu-desc">查看预约进度</text>
      </view>
      <view wx:if="{{user.currentRole === 'teacher'}}" class="core-menu-item tap-feedback" bindtap="goTeacherAction">
        <text class="core-menu-title">资料管理</text>
        <text class="core-menu-desc">入驻与认证状态</text>
      </view>
      <view wx:if="{{user.currentRole === 'teacher'}}" class="core-menu-item tap-feedback" bindtap="goTeacherReviews">
        <text class="core-menu-title">服务评价</text>
        <text class="core-menu-desc">查看家长反馈</text>
      </view>
      <view wx:if="{{user.currentRole !== 'teacher'}}" class="core-menu-item tap-feedback" bindtap="goPublishRequirement">
        <text class="core-menu-title">发布需求</text>
        <text class="core-menu-desc">填写辅导需求</text>
      </view>
    </view>
  </view>

  <view wx:else class="profile-card guest-card">
    <view class="module-title">开始使用</view>
    <view class="module-desc">登录后可查看订单、完善资料并使用身份专属服务。</view>
    <button class="guest-login-btn" bindtap="goLogin">去登录</button>
  </view>

  <view class="profile-card service-card">
    <view class="section-head service-head">
      <view>
        <view class="module-title">服务与帮助</view>
        <view class="module-desc">使用说明、记录与平台支持</view>
      </view>
    </view>
    <view class="service-grid">
      <view class="service-item tap-feedback" bindtap="goAgreement"><text class="service-title">用户协议</text><text class="service-desc">使用规则</text></view>
      <view class="service-item tap-feedback" bindtap="goPrivacy"><text class="service-title">隐私政策</text><text class="service-desc">信息保护</text></view>
      <view class="service-item tap-feedback" bindtap="goUnlockRecords"><text class="service-title">联系方式解锁记录</text><text class="service-desc">购买与解锁</text></view>
      <view class="service-item tap-feedback" bindtap="goContactLogs"><text class="service-title">联系记录</text><text class="service-desc">沟通留痕</text></view>
      <view class="service-item tap-feedback" bindtap="contact"><text class="service-title">联系客服</text><text class="service-desc">获取帮助</text></view>
      <view class="service-item tap-feedback" bindtap="showAbout"><text class="service-title">关于我们</text><text class="service-desc">了解平台</text></view>
    </view>
  </view>

  <view wx:if="{{demoModeEnabled}}" class="demo-entry tap-feedback" bindtap="goDemoMode">
    <view>
      <view class="demo-entry-title">演示模式</view>
      <view class="demo-entry-desc">本地体验家长和老师完整流程</view>
    </view>
    <text class="demo-entry-arrow">›</text>
  </view>

  <button wx:if="{{user}}" class="account-action-button logout-button" bindtap="logout">{{demoModeActive ? '退出演示模式' : '退出登录'}}</button>
  <button wx:else class="account-action-button login-button" bindtap="goLogin">登录</button>
  <view class="bottom-safe-space"></view>
</view>

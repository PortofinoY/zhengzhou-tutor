page {
  background: #F6F8F8;
}

.profile-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #EBF8F6 0%, #F6F8F8 35%, #F6F8F8 100%);
}

.profile-hero,
.profile-card {
  border: 1rpx solid rgba(30, 58, 95, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 28rpx rgba(30, 58, 95, 0.055);
}

.profile-hero {
  padding: 28rpx;
}

.profile-user-row,
.user-tags,
.hero-actions,
.section-head,
.core-action,
.service-item {
  display: flex;
  align-items: center;
}

.profile-user-row {
  gap: 20rpx;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 30rpx;
  color: #1E9E90;
  background: #E9F8F5;
  font-size: 36rpx;
  font-weight: 800;
}

.avatar-img {
  width: 100rpx;
  height: 100rpx;
}

.user-copy {
  min-width: 0;
  flex: 1;
}

.user-name {
  overflow: hidden;
  color: #1F2933;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-desc,
.module-desc,
.core-action-desc,
.core-menu-desc,
.service-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.42;
}

.profile-arrow,
.core-action-arrow {
  flex: none;
  color: #9BA8AE;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
}

.user-tags {
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.pill,
.status-pill {
  min-height: 38rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
}

.pill-cert,
.pill-success,
.status-success {
  color: #159482;
  background: #EAF8F4;
}

.pill-warning,
.status-warning {
  color: #C98314;
  background: #FFF6E7;
}

.pill-demo {
  color: #54729A;
  background: #EEF4FC;
}

.status-neutral {
  color: #6B7280;
  background: #F3F5F6;
}

.status-error {
  color: #D94A4A;
  background: #FFF0F0;
}

.hero-actions {
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
}

.identity-btn,
.login-main-btn,
.guest-login-btn {
  height: 60rpx;
  box-sizing: border-box;
  padding: 0 26rpx;
  border: 1rpx solid #DDE8E7;
  border-radius: 999rpx;
  color: #1E3A5F;
  background: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.identity-btn.primary,
.login-main-btn,
.guest-login-btn {
  border-color: #2BB3A3;
  color: #FFFFFF;
  background: #2BB3A3;
  box-shadow: 0 8rpx 16rpx rgba(43, 179, 163, 0.16);
}

.login-main-btn {
  width: 252rpx;
  margin: 24rpx auto 0;
}

.state-strip {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  color: #6B7280;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  text-align: center;
}

.state-error {
  color: #C98314;
}

.profile-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.section-head {
  justify-content: space-between;
  gap: 18rpx;
}

.module-title {
  color: #1F2933;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.core-action {
  justify-content: space-between;
  min-height: 98rpx;
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #2BB3A3, #55C8BB);
}

.core-action-teacher {
  background: linear-gradient(135deg, #1E3A5F, #31567F);
}

.core-action-title {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.core-action-desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.84);
}

.core-action-arrow {
  color: rgba(255, 255, 255, 0.9);
}

.core-menu-grid,
.service-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 14rpx;
}

.core-menu-item {
  min-width: 0;
  min-height: 100rpx;
  box-sizing: border-box;
  padding: 19rpx 18rpx;
  border: 1rpx solid #E5EEED;
  border-radius: 20rpx;
  background: #F8FBFB;
}

.core-menu-title,
.service-title {
  overflow: hidden;
  display: block;
  color: #1F2933;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.core-menu-desc {
  overflow: hidden;
  margin-top: 6rpx;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.guest-card {
  padding: 26rpx 24rpx;
}

.guest-login-btn {
  width: 180rpx;
  margin: 20rpx 0 0;
}

.service-card {
  padding-bottom: 22rpx;
}

.service-head {
  margin-bottom: 4rpx;
}

.service-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.service-item {
  min-width: 0;
  min-height: 108rpx;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  padding: 12rpx 8rpx;
  border: 1rpx solid #E5EEED;
  border-radius: 20rpx;
  background: #F8FBFB;
  text-align: center;
}

.demo-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #DDE8E7;
  border-radius: 22rpx;
  color: #1E3A5F;
  background: rgba(255, 255, 255, 0.8);
}

.demo-entry-title { font-size: 26rpx; font-weight: 800; }
.demo-entry-desc { margin-top: 6rpx; color: #6B7280; font-size: 21rpx; }
.demo-entry-arrow { color: #9BA8AE; font-size: 38rpx; line-height: 1; }

.service-title {
  max-width: 100%;
  font-size: 22rpx;
}

.service-desc {
  overflow: hidden;
  max-width: 100%;
  margin-top: 6rpx;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-action-button {
  width: 100%;
  height: 84rpx;
  margin-top: 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.logout-button {
  border: 1rpx solid #F3D7D7;
  color: #D94A4A;
  background: #FFF8F8;
}

.login-button {
  border: 1rpx solid #2BB3A3;
  color: #FFFFFF;
  background: #2BB3A3;
  box-shadow: 0 10rpx 20rpx rgba(43, 179, 163, 0.16);
}

.bottom-safe-space {
  height: calc(28rpx + env(safe-area-inset-bottom));
}

.tap-feedback:active,
.core-menu-item:active,
.account-action-button:active,
.identity-btn:active,
.login-main-btn:active,
.guest-login-btn:active {
  transform: scale(0.985);
  opacity: 0.9;
}

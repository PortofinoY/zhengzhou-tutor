page {
  background: #F7F9FA;
}

.profile-page {
  min-height: 100vh;
  padding: 26rpx 32rpx 44rpx;
  background:
    radial-gradient(circle at 80% 0%, rgba(32, 199, 181, 0.14), transparent 34%),
    linear-gradient(180deg, #EAFBF7 0%, #F7F9FA 36%, #FFFFFF 100%);
}

.profile-hero,
.profile-card,
.test-card {
  border: 1rpx solid #E5F0EE;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 30rpx rgba(30, 58, 95, 0.06);
}

.profile-hero {
  padding: 30rpx;
  background:
    radial-gradient(circle at 88% 20%, rgba(32, 199, 181, 0.14), transparent 32%),
    rgba(255, 255, 255, 0.9);
}

.profile-user-row,
.user-tags,
.hero-actions,
.role-head,
.role-actions,
.teacher-stats,
.service-item,
.test-card,
.test-actions {
  display: flex;
  align-items: center;
}

.profile-user-row {
  gap: 24rpx;
}

.avatar-wrap {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 34rpx;
  color: #20C7B5;
  background: linear-gradient(145deg, #DDF8F3, #FFFFFF);
  font-size: 38rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 22rpx rgba(32, 199, 181, 0.12);
}

.avatar-img {
  width: 112rpx;
  height: 112rpx;
}

.user-copy {
  min-width: 0;
  flex: 1;
}

.user-name {
  color: #1F2933;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.18;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-desc,
.module-desc,
.test-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.42;
}

.user-tags {
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.pill,
.status-pill {
  min-height: 38rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
}

.pill-cert,
.status-success,
.pill-success {
  color: #20A894;
  background: #EAFBF7;
}

.pill-warning,
.status-warning {
  color: #F59E0B;
  background: #FFF7E8;
}

.status-neutral {
  color: #6B7280;
  background: #F7F9FA;
}

.status-error {
  color: #EF4444;
  background: #FEECEC;
}

.hero-actions {
  gap: 14rpx;
  justify-content: flex-end;
  margin-top: 22rpx;
}

.identity-btn,
.login-main-btn,
.test-btn {
  height: 58rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.identity-btn {
  color: #1E3A5F;
  background: #FFFFFF;
  border: 1rpx solid #E5F0EE;
}

.identity-btn.primary,
.login-main-btn,
.test-btn.primary {
  color: #FFFFFF;
  border: 0;
  background: linear-gradient(135deg, #20C7B5 0%, #35D6C4 100%);
  box-shadow: 0 8rpx 18rpx rgba(32, 199, 181, 0.18);
}

.login-main-btn {
  width: 260rpx;
  margin: 28rpx auto 0;
}

.profile-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.role-head {
  justify-content: space-between;
  gap: 18rpx;
}

.module-title {
  color: #1F2933;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.role-actions {
  margin-top: 24rpx;
}

.two-col {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.two-col .btn,
.role-actions .btn {
  min-height: 72rpx;
  font-size: 27rpx;
}

.quick-card {
  padding-bottom: 22rpx;
}

.quick-grid,
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22rpx 10rpx;
  margin-top: 26rpx;
}

.quick-item {
  min-width: 0;
  text-align: center;
}

.quick-icon,
.service-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12rpx;
  border-radius: 22rpx;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 18rpx rgba(30, 58, 95, 0.07);
}

.color-a { background: linear-gradient(145deg, #20C7B5, #67E1D3); }
.color-b { background: linear-gradient(145deg, #55A8FF, #8CC8FF); }
.color-c { background: linear-gradient(145deg, #5B7CFA, #9BAFFF); }
.color-d { background: linear-gradient(145deg, #F8A04E, #FFD18B); }
.color-e { background: linear-gradient(145deg, #58D39A, #8AE6BA); }
.color-f { background: linear-gradient(145deg, #FF7A7A, #FFB0A8); }
.color-g { background: linear-gradient(145deg, #9B8CFF, #C4B9FF); }
.color-h { background: linear-gradient(145deg, #45C2EA, #83E1F6); }

.quick-title {
  color: #1F2933;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 1.2;
  white-space: nowrap;
}

.teacher-service {
  padding-bottom: 24rpx;
}

.teacher-stats {
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.stat-box {
  width: calc(50% - 7rpx);
  min-height: 86rpx;
  padding: 16rpx;
  border: 1rpx solid #E5F0EE;
  border-radius: 22rpx;
  background: #F5FBFA;
}

.stat-label {
  display: block;
  margin-bottom: 8rpx;
  color: #6B7280;
  font-size: 21rpx;
  font-weight: 800;
}

.stat-value {
  color: #1E3A5F;
  font-size: 27rpx;
  font-weight: 900;
}

.service-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.service-item {
  min-height: 108rpx;
  flex-direction: column;
  justify-content: center;
  border: 1rpx solid #E5F0EE;
  border-radius: 24rpx;
  background: #F5FBFA;
  color: #1F2933;
  font-size: 23rpx;
  font-weight: 850;
}

.service-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 9rpx;
  border-radius: 16rpx;
  color: #20C7B5;
  background: #EAFBF7;
  box-shadow: none;
  font-size: 20rpx;
}

.service-item.danger,
.service-item.danger .service-icon {
  color: #EF4444;
}

.service-item.danger .service-icon {
  background: #FEECEC;
}

.test-card {
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  opacity: 0.76;
}

.test-title {
  color: #6B7280;
  font-size: 24rpx;
  font-weight: 900;
}

.test-actions {
  gap: 10rpx;
}

.test-btn {
  min-width: 96rpx;
  color: #1E3A5F;
  background: #FFFFFF;
  border: 1rpx solid #E5F0EE;
}

.test-btn.secondary {
  color: #1E3A5F;
  background: #FFFFFF;
}

.quick-item:active,
.service-item:active,
.test-btn:active,
.identity-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.order-grid,
.order-item,
.order-icon,
.order-count,
.order-title,
.arrow,
.safe-note,
.section-label,
.guest-role-actions,
.guest-login-note,
.login-btn {
  display: none;
}

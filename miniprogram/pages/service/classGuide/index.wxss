.service-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #F5FBFA;
}

.service-hero,
.service-card {
  border: 1rpx solid #E5F0EE;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 26rpx rgba(30, 58, 95, 0.05);
}

.service-hero {
  padding: 34rpx 30rpx;
  background: linear-gradient(135deg, #E8FBF8 0%, #FFFFFF 100%);
}

.hero-label {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #20B8A7;
  background: #E8FBF8;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 18rpx;
  color: #1F2933;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.18;
}

.hero-desc,
.card-text {
  margin-top: 14rpx;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.62;
}

.service-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.card-title {
  color: #1F2933;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.flow-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.flow-item {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1E3A5F;
  background: #F0FAF8;
  border: 1rpx solid #D7F2ED;
  font-size: 23rpx;
  font-weight: 800;
}

.list-item {
  position: relative;
  margin-top: 16rpx;
  padding-left: 24rpx;
  color: #1F2933;
  font-size: 25rpx;
  line-height: 1.55;
}

.list-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #20C7B5;
}

.tip-card {
  background: #F8FFFD;
}

.note-box {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #1E3A5F;
  background: #F0FAF8;
  border: 1rpx solid #D7F2ED;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.5;
}

.bottom-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
  padding-bottom: 24rpx;
}

.btn-primary,
.btn-secondary {
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.btn-primary {
  color: #FFFFFF;
  background: #20C7B5;
}

.btn-secondary {
  color: #1E3A5F;
  background: #FFFFFF;
  border: 1rpx solid #E5F0EE;
}

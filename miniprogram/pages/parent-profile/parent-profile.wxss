.parent-profile-page {
  padding-bottom: 44rpx;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.choice {
  min-height: 58rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #6B7280;
  background: #F7F8FA;
  border: 1rpx solid #E5EAF0;
  transition: transform 180ms ease, opacity 180ms ease;
}

.choice:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.choice.active {
  color: #FFFFFF;
  background: #2BB3A3;
  border-color: #2BB3A3;
}

.phone-auth-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #E5EAF0;
  border-radius: 20rpx;
  background: #F7F8FA;
}

.phone-auth-title {
  color: #1F2933;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.phone-auth-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.4;
}

.mini-auth-btn,
.phone-bound-tag {
  flex: none;
  min-width: 104rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.mini-auth-btn {
  background: #2BB3A3;
  color: #FFFFFF;
}

.phone-bound-tag {
  background: #E8F7F4;
  color: #2BB3A3;
}

.spacing {
  margin-top: 28rpx;
}

.remark-item {
  margin-top: 26rpx;
}

.privacy-note {
  margin: -2rpx 4rpx 24rpx;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.6;
}

.submit {
  margin-bottom: 34rpx;
}

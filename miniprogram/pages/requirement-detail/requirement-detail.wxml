<view class="page requirement-detail-page" wx:if="{{requirement}}">
  <view class="band requirement-band">
    <view class="title">{{requirement.childGrade}} · {{requirement.subject}}</view>
    <view class="subtitle">{{requirement.parentDisplayName}}｜{{requirement.district}}｜预算 ¥{{requirement.budgetPrice}}/小时</view>
    <view class="tag-row">
      <text class="tag">{{requirement.expectedTime}}</text>
      <text class="tag-neutral">{{requirement.unlocked ? '已解锁联系方式' : '基础信息'}}</text>
    </view>
  </view>

  <view class="section-title">学习情况</view>
  <view class="card text-block">{{requirement.studySituation}}</view>

  <view class="section-title">对老师的要求</view>
  <view class="card text-block">{{requirement.teacherRequirement}}</view>
  <button wx:if="{{canEditDemo}}" class="btn btn-ghost" bindtap="editRequirement">编辑需求</button>

  <view class="section-title">联系方式</view>
  <view wx:if="{{!requirement.unlocked}}" class="card lock-card">
    <view class="lock-title">联系方式已隐藏</view>
    <view class="muted">{{requirement.contactLockedText}}</view>
    <view class="masked-line">手机号：{{requirement.contactPhoneMasked || '解锁后可见'}}</view>
    <button class="btn btn-primary unlock-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="unlockContact">
      <text>{{loading ? '解锁中...' : '49.9元解锁联系方式'}}</text>
    </button>
  </view>
  <view wx:else class="card contact-card">
    <view class="contact-row">
      <text class="contact-label">手机号</text>
      <text class="contact-value">{{requirement.contactPhone}}</text>
    </view>
    <view wx:if="{{requirement.contactWechat}}" class="contact-row">
      <text class="contact-label">微信号</text>
      <text class="contact-value">{{requirement.contactWechat}}</text>
    </view>
    <view class="muted contact-note">请遵守平台规则沟通，不公开孩子姓名、学校、班级和详细住址。</view>
    <button class="btn btn-ghost contact-log-btn" loading="{{contactLogging}}" disabled="{{contactLogging}}" bindtap="recordContact">记录已联系</button>
    <button wx:if="{{isTeacherDemo}}" class="btn btn-primary contact-log-btn" loading="{{accepting}}" disabled="{{accepting}}" bindtap="acceptRequirement">确认接单</button>
  </view>
</view>

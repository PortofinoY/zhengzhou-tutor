<view class="page records-page">
  <view class="records-hero">
    <view class="records-title">联系记录</view>
    <view class="records-subtitle">记录已联系、已约课或未联系上的跟进状态。</view>
  </view>

  <view wx:if="{{logs.length === 0}}" class="empty-card">
    <view class="empty-icon">联</view>
    <view class="empty-title">暂无联系记录</view>
    <view class="empty-desc">解锁联系方式后，在详情页点击“记录已联系”即可生成留痕。</view>
  </view>

  <view wx:for="{{logs}}" wx:key="id" class="record-card tap-active" data-id="{{item.id}}" bindtap="openDetail">
    <view class="record-head">
      <view>
        <view class="record-title">{{item.targetName || item.typeText}}</view>
        <view class="record-meta">{{item.targetSummary || item.typeText}}</view>
      </view>
      <view class="status-pill">{{item.statusText}}</view>
    </view>
    <view class="record-foot">
      <text class="record-time">{{item.timeText}}</text>
      <text wx:if="{{item.note}}" class="record-note">{{item.note}}</text>
    </view>
  </view>
</view>

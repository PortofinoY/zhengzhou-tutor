page {
  background: #FFFFFF;
}

.home-page {
  min-height: 100vh;
  padding: 22rpx 24rpx 48rpx;
  color: #1F2933;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  background: #FFFFFF;
}

.top-visual {
  position: relative;
  overflow: hidden;
  margin: -24rpx -24rpx 0;
  min-height: 560rpx;
  padding: 54rpx 24rpx 46rpx;
  background: #E7FCF8;
}

.top-visual::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(90deg, rgba(232, 255, 250, 0.96) 0%, rgba(232, 255, 250, 0.84) 40%, rgba(232, 255, 250, 0.38) 68%, rgba(232, 255, 250, 0.18) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.78) 100%);
  pointer-events: none;
}

.top-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.92;
}

.home-top {
  position: relative;
  z-index: 2;
  padding-top: 0;
}

.brand-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  min-height: 56rpx;
  padding-top: 10rpx;
}

.brand-copy {
  position: relative;
  max-width: 470rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  padding: 8rpx 0 0;
  overflow: hidden;
  box-sizing: border-box;
}

.brand-name {
  position: relative;
  color: #1E3A5F;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
  white-space: nowrap;
  letter-spacing: 0;
}

.brand-name::before {
  display: none;
}

.brand-slogan {
  position: relative;
  color: #637184;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 0;
  white-space: nowrap;
}

.demo-home-badge {
  display: inline-flex;
  align-items: center;
  min-height: 34rpx;
  margin-top: 10rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #54729A;
  background: rgba(238, 244, 252, 0.92);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.brand-slogan::before {
  display: none;
}

.search-card {
  height: 86rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 0 12rpx 0 24rpx;
  border: 2rpx solid #8EEAD9;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(30, 58, 95, 0.04);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.search-icon {
  color: #B6C0CB;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 68rpx;
  color: #1F2933;
  font-size: 28rpx;
  font-weight: 700;
}

.search-input-placeholder {
  color: #B6C0CB;
}

.search-button,
.match-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #22CDB9;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
  transition: transform 180ms ease, opacity 180ms ease;
}

.search-button {
  width: 158rpx;
  height: 62rpx;
  font-size: 26rpx;
}

button::after {
  border: 0;
}

.stage-row {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 320rpx;
  padding: 0 2rpx;
}

.stage-item {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(34, 205, 185, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 10rpx 22rpx rgba(30, 58, 95, 0.06);
  animation: stagePop 300ms ease both;
  transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
}

.stage-item:nth-child(2) {
  animation-delay: 40ms;
}

.stage-item:nth-child(3) {
  animation-delay: 80ms;
}

.stage-icon {
  display: none;
}

.stage-name {
  color: #1E3A5F;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.stage-primary {
  border-color: rgba(34, 205, 185, 0.36);
  background: rgba(234, 251, 247, 0.92);
}

.stage-middle {
  border-color: rgba(127, 156, 245, 0.28);
  background: rgba(246, 248, 255, 0.92);
}

.stage-high {
  border-color: rgba(245, 157, 46, 0.24);
  background: rgba(255, 250, 243, 0.92);
}

.banner-section {
  margin-top: 28rpx;
  animation-delay: 70ms;
}

.marketing-swiper {
  height: 216rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.banner-card {
  position: relative;
  overflow: hidden;
  height: 190rpx;
  margin: 0 2rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid #E5F0EE;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 30rpx rgba(30, 58, 95, 0.08);
  transition: transform 180ms ease, opacity 180ms ease;
}

.banner-card::after {
  content: "";
  position: absolute;
  right: -44rpx;
  top: -58rpx;
  width: 188rpx;
  height: 188rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
}

.banner-title {
  position: relative;
  z-index: 2;
  color: #1F2933;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.18;
}

.banner-desc {
  position: relative;
  z-index: 2;
  width: 72%;
  margin-top: 10rpx;
  color: #6B7280;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.42;
}

.banner-button {
  position: relative;
  z-index: 2;
  width: 176rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #2BB3A3;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.banner-mint {
  background: linear-gradient(135deg, #E8FBF8 0%, #FFFFFF 100%);
}

.banner-blue {
  background: linear-gradient(135deg, #EEF5FF 0%, #FFFFFF 100%);
}

.banner-blue .banner-button {
  background: #1E6FE8;
}

.banner-purple {
  background: linear-gradient(135deg, #F5EFFF 0%, #FFFFFF 100%);
}

.banner-purple .banner-button {
  background: #7D6AF2;
}

.banner-warm {
  background: linear-gradient(135deg, #FFF5E8 0%, #FFFFFF 100%);
}

.banner-warm .banner-button {
  background: #F59E0B;
}

.banner-green {
  background: linear-gradient(135deg, #EAF8EF 0%, #FFFFFF 100%);
}

.banner-green .banner-button {
  background: #22C55E;
}

.home-actions {
  display: grid;
  grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
  align-items: stretch;
  gap: 20rpx;
  margin-top: 32rpx;
  animation-delay: 120ms;
}

.audience-column {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 20rpx;
}

.audience-card {
  flex: 1;
  min-height: 152rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  background: #F3F8FC;
  box-shadow: 0 10rpx 28rpx rgba(30, 58, 95, 0.04);
  transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
}

.audience-copy {
  min-width: 0;
  width: 100%;
}

.audience-title,
.match-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.12;
}

.audience-title {
  color: #122033;
}

.audience-desc,
.match-desc {
  margin-top: 8rpx;
  color: #8C98AA;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.32;
}

.audience-desc {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.audience-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 20rpx;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.arrow-icon {
  background: linear-gradient(135deg, #A9CBFF 0%, #7F6DF2 100%);
}

.pin-icon {
  color: #47A8F5;
  background: #D7ECFF;
}

.match-card {
  min-height: 324rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  margin-top: 0;
  padding: 26rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #33A7F8 0%, #6DE8D6 100%);
  box-shadow: 0 18rpx 34rpx rgba(33, 166, 226, 0.16);
  text-align: center;
  transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
}

.match-title {
  color: #FFFFFF;
}

.match-desc {
  margin-top: 16rpx;
  color: #E8FFFC;
}

.match-button {
  width: 176rpx;
  max-width: 100%;
  height: 54rpx;
  margin: 24rpx auto 0;
}

.fade-up {
  animation: fadeUp 320ms ease both;
}

.search-card:active,
.search-button:active,
.stage-item:active,
.banner-card:active,
.banner-button:active,
.audience-card:active,
.match-card:active {
  transform: scale(0.975);
  opacity: 0.92;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes stagePop {
  from { opacity: 0; transform: translateY(10rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

page {
  background: #FFFFFF;
}

.home-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 44rpx;
  color: #1F2933;
  font-family: sans-serif;
  background: #FFFFFF;
}

.top-visual {
  position: relative;
  overflow: hidden;
  margin: -24rpx -24rpx 0;
  padding: 52rpx 24rpx 34rpx;
  background: #E7FCF8;
}

.top-visual::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(90deg, rgba(232, 255, 250, 0.96) 0%, rgba(232, 255, 250, 0.84) 40%, rgba(232, 255, 250, 0.38) 68%, rgba(232, 255, 250, 0.18) 100%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.78) 100%);
  pointer-events: none;
}

.top-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.92;
}

.home-top {
  position: relative;
  z-index: 2;
  padding-top: 0;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 56rpx;
}

.brand-name {
  color: #079886;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.search-card {
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 30rpx;
  padding: 0 14rpx 0 24rpx;
  border: 2rpx solid #8EEAD9;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.search-icon {
  color: #B6C0CB;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 72rpx;
  color: #1F2933;
  font-size: 30rpx;
  font-weight: 700;
}

.search-input-placeholder {
  color: #B6C0CB;
}

.search-button,
.match-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #22CDB9;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.search-button {
  width: 128rpx;
  height: 60rpx;
}

button::after {
  border: 0;
}

.stage-row {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 30rpx;
  margin-top: 36rpx;
  padding: 0 20rpx;
}

.stage-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stage-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #E9FBF8;
  color: #22CDB9;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 10rpx 24rpx rgba(25, 172, 157, 0.14);
}

.stage-name {
  margin-top: 18rpx;
  color: #3F4652;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stage-primary .stage-icon {
  color: #22CDB9;
  background: #E8FBF8;
}

.stage-middle .stage-icon {
  color: #7F9CF5;
  background: #EEF3FF;
}

.stage-high .stage-icon {
  color: #F59D2E;
  background: #FFF4E5;
}

.home-actions {
  display: grid;
  grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
  gap: 24rpx;
  margin-top: 46rpx;
}

.audience-column {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.audience-card {
  min-height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 26rpx 24rpx;
  border-radius: 24rpx;
  background: #F3F8FC;
}

.audience-copy {
  min-width: 0;
  flex: 1;
}

.audience-title,
.match-title,
.section-title,
.tile-title {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.12;
}

.audience-title {
  color: #122033;
}

.audience-desc,
.match-desc,
.tile-desc {
  margin-top: 14rpx;
  color: #8C98AA;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.audience-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.arrow-icon {
  background: linear-gradient(135deg, #A9CBFF 0%, #7F6DF2 100%);
}

.pin-icon {
  color: #47A8F5;
  background: #D7ECFF;
}

.match-card {
  min-height: 312rpx;
  padding: 28rpx 18rpx 20rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #33A7F8 0%, #6DE8D6 100%);
  box-shadow: 0 18rpx 34rpx rgba(33, 166, 226, 0.16);
  text-align: center;
}

.match-title {
  color: #FFFFFF;
}

.match-desc {
  color: #E8FFFC;
}

.match-button {
  width: 146rpx;
  max-width: 100%;
  height: 52rpx;
  margin: 48rpx auto 0;
}

.recommend-section {
  margin-top: 48rpx;
}

.section-title {
  color: #080B10;
}

.recommend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28rpx 24rpx;
  margin-top: 28rpx;
}

.recommend-tile {
  min-height: 132rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.tile-title {
  color: #FFFFFF;
}

.tile-desc {
  color: rgba(255, 255, 255, 0.86);
}

.tile-mint {
  background: #83D8D4;
}

.tile-blue {
  background: #82A9F4;
}

.tile-warm {
  background: #E9B468;
}

.tile-green {
  background: #75C99B;
}

.fade-up {
  animation: fadeUp 240ms ease both;
}

.search-button:active,
.stage-item:active,
.audience-card:active,
.match-card:active,
.recommend-tile:active {
  transform: scale(0.98);
  opacity: 0.92;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

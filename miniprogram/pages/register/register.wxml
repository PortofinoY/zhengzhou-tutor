<view class="page register-page">
  <view class="section brand-card">
    <view class="title"><text class="title-icon">注</text>注册账号</view>
    <view class="subtitle">注册后需选择家长或老师身份，并完善对应资料后进入首页。</view>
  </view>

  <view class="section">
    <view class="form-item">
      <view class="label">手机号</view>
      <input class="input" type="number" maxlength="11" placeholder-class="input-placeholder" placeholder="请输入手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <view class="label">密码</view>
      <input class="input" type="password" placeholder-class="input-placeholder" placeholder="至少8位，包含字母和数字" value="{{form.password}}" data-field="password" bindinput="onInput" />
    </view>
    <view class="form-item">
      <view class="label">确认密码</view>
      <input class="input" type="password" placeholder-class="input-placeholder" placeholder="请再次输入密码" value="{{form.confirmPassword}}" data-field="confirmPassword" bindinput="onInput" />
    </view>
    <view class="form-item">
      <view class="label">验证码</view>
      <view class="code-row">
        <input class="input code-input" type="number" maxlength="6" placeholder-class="input-placeholder" placeholder="演示验证码 123456" value="{{form.smsCode}}" data-field="smsCode" bindinput="onInput" />
        <button class="code-btn" bindtap="fillMockCode">获取验证码</button>
      </view>
      <view class="form-hint">MVP 演示阶段验证码固定为 123456。</view>
    </view>

    <label class="agreement">
      <checkbox checked="{{agreed}}" bindtap="toggleAgree" />
      <text>我已阅读并同意</text>
      <text class="link" bindtap="goAgreement">《用户协议》</text>
      <text>和</text>
      <text class="link" bindtap="goPrivacy">《隐私政策》</text>
    </label>

    <button class="btn btn-primary" disabled="{{loading}}" bindtap="submit">
      <text class="btn-icon">✓</text>
      <text>{{loading ? '注册中...' : '注册并继续'}}</text>
    </button>
    <view class="login-row">
      <text class="login-text">已有账号？</text>
      <text class="login-link" bindtap="goLogin">返回登录</text>
    </view>
  </view>
</view>

page {
  --color-primary: #1E3A5F;
  --color-secondary: #20C7B5;
  --color-bg: #F7F9FA;
  --color-card: #FFFFFF;
  --color-text-primary: #1F2933;
  --color-text-secondary: #6B7280;
  --color-border: #E5F0EE;
  --color-success: #22C55E;
  --color-warning: #F59E0B;
  --color-error: #EF4444;
  min-height: 100%;
  background: #F7F9FA;
  color: #1F2933;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 27rpx;
  line-height: 1.5;
  letter-spacing: 0;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

view,
text,
button,
input,
textarea,
picker,
scroll-view,
image {
  box-sizing: border-box;
}

button {
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  text-align: center;
  background: transparent;
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

button text {
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #F7F9FA;
  box-sizing: border-box;
  animation: pageFadeUp 360ms ease both;
}

.band,
.section,
.card,
.teacher-card,
.order-card,
.review-card,
.audit-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #E5F0EE;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(30, 58, 95, 0.05);
  animation: cardRise 260ms ease both;
}

.band {
  margin: 0 -24rpx 24rpx;
  padding: 34rpx 24rpx;
  border-left: 0;
  border-right: 0;
  border-radius: 0 0 24rpx 24rpx;
  background: #1E3A5F;
  color: #FFFFFF;
}

.band .title,
.band .subtitle {
  color: #FFFFFF;
}

.band .subtitle {
  opacity: 0.82;
}

.band .tag {
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.16);
}

.section,
.card,
.teacher-card,
.order-card,
.review-card,
.audit-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.title {
  color: #1F2933;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.24;
}

.subtitle {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.55;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 28rpx 0 16rpx;
  color: #1F2933;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-title::before {
  content: "";
  width: 10rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #20C7B5;
}

.muted {
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.56;
}

.price {
  color: #1E3A5F;
  font-weight: 800;
}

.tag,
.tag-cert,
.tag-neutral,
.tag-success,
.tag-amber,
.tag-warning,
.tag-red,
.tag-error {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  margin: 8rpx 8rpx 0 0;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  vertical-align: middle;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag,
.tag-cert {
  color: #20C7B5;
  background: #EAFBF7;
}

.tag-neutral {
  color: #6B7280;
  background: #F7F9FA;
}

.tag-success {
  color: #22C55E;
  background: #EAF8EF;
}

.tag-amber,
.tag-warning {
  color: #F59E0B;
  background: #FFF7E8;
}

.tag-red,
.tag-error {
  color: #EF4444;
  background: #FEECEC;
}

.btn,
.btn-primary,
.btn-secondary,
.btn-ghost,
.btn-warn,
.btn-danger,
.button-primary,
.button-secondary,
.button-danger {
  width: 100%;
  min-height: 80rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0;
  text-align: center;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transform: translateZ(0);
  transition: transform 180ms ease, opacity 180ms ease, box-shadow 180ms ease;
}

.search-button,
.reset-button,
.code-btn,
.empty-action,
.mini-auth-btn,
.mini-btn,
.test-btn {
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  text-align: center;
}

.btn:active,
.btn-primary:active,
.btn-secondary:active,
.btn-ghost:active,
.btn-warn:active,
.btn-danger:active,
.button-primary:active,
.button-secondary:active,
.button-danger:active {
  transform: scale(0.985);
  opacity: 0.9;
}

.btn-primary,
.button-primary {
  color: #FFFFFF;
  background: #20C7B5;
  box-shadow: 0 4rpx 18rpx rgba(32, 199, 181, 0.18);
}

.btn-secondary,
.btn-ghost,
.button-secondary {
  color: #1E3A5F;
  background: #FFFFFF;
  border: 1rpx solid #E5F0EE;
}

.btn-warn {
  color: #F59E0B;
  background: #FFF7E8;
  border: 1rpx solid #FFE6B0;
}

.btn-danger,
.button-danger {
  color: #FFFFFF;
  background: #EF4444;
}

.btn-disabled,
.btn[disabled],
.btn-primary[disabled],
.button-primary[disabled],
.button-secondary[disabled] {
  color: #FFFFFF;
  background: #D1D5DB;
  border-color: #D1D5DB;
  box-shadow: none;
}

.icon,
.btn-icon,
.field-icon,
.title-icon {
  width: 42rpx;
  height: 42rpx;
  flex: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #20C7B5;
  background: #EAFBF7;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}

.title-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
  color: #FFFFFF;
  background: #1E3A5F;
  vertical-align: middle;
}

.btn-primary .btn-icon,
.btn-danger .btn-icon,
.button-primary .btn-icon,
.button-danger .btn-icon {
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.18);
}

.btn-icon,
.field-icon,
.title-icon,
.quick-icon,
.service-icon,
.trust-icon,
.stage-icon,
.identity-icon,
.phone-icon,
.rule-icon,
.stat-icon,
.orders-empty-icon,
.orders-list-empty-icon,
.role-current-icon,
.order-avatar,
.inline-icon {
  display: none !important;
}

.input,
.textarea,
.picker,
.picker-value {
  width: 100%;
  min-height: 78rpx;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border: 1rpx solid #E5F0EE;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #1F2933;
  font-size: 27rpx;
  line-height: 1.45;
  transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
}

.input:focus,
.textarea:focus {
  border-color: rgba(32, 199, 181, 0.72);
  box-shadow: 0 0 0 4rpx rgba(32, 199, 181, 0.1);
}

.input-placeholder,
.textarea-placeholder {
  color: #9CA3AF;
}

.textarea {
  min-height: 168rpx;
  align-items: flex-start;
}

.form-item {
  margin-bottom: 22rpx;
}

.label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
  color: #1F2933;
  font-size: 25rpx;
  font-weight: 700;
}

.empty {
  padding: 78rpx 24rpx;
  border: 1rpx solid #E5F0EE;
  border-radius: 20rpx;
  background: #FFFFFF;
  color: #6B7280;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(30, 58, 95, 0.04);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  flex: none;
  margin-right: 18rpx;
  border-radius: 22rpx;
  background: #E5F0EE;
  box-shadow: 0 4rpx 18rpx rgba(30, 58, 95, 0.08);
}

.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
  padding: 18rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #E5F0EE;
  box-shadow: 0 -4rpx 24rpx rgba(30, 58, 95, 0.06);
}

.safe-bottom,
.with-bottom {
  padding-bottom: 148rpx;
}

@keyframes pageFadeUp {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes cardRise {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
